// ============================================================
// Qwen Code settings 配置模板（脱敏版）
// 本文件不包含任何真实 API Key，发布安全。
// 用法：
//   1. 将本文件复制为 ~/.qwen/settings.json
//   2. 替换 env 中的占位符为真实 key（ChatGPT OAuth 模式 OPENAI_API_KEY 可为空）
//   3. GPT 模型 baseUrl 指向本地综合代理 http://127.0.0.1:11435/v1
// 关键配置说明：
//   - gpt-5.6 系列 reasoning_effort=medium：ChatGPT 后端在 none 时输出预算仅 ~400 tokens，medium 时 ~3000+
//   - 不要设置 max_completion_tokens：ChatGPT 后端不支持（400 Unsupported parameter）
//   - -chatgpt 后缀模型走 ChatGPT OAuth（设备码登录），非 -chatgpt 走 Platform API
// ============================================================
{
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "modelProviders": {
    "openai": [
      {
        "id": "deepseek-v4-flash",
        "name": "deepseek-v4-flash",
        "envKey": "DEEPSEEK_API_KEY",
        "baseUrl": "https://api.deepseek.com",
        "generationConfig": {
          "timeout": 120000,
          "contextWindowSize": 1000000,
          "reasoning": {
            "effort": "high"
          },
          "samplingParams": {
            "temperature": 0.7,
            "max_tokens": 81920
          }
        }
