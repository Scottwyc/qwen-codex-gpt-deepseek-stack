# DeepSeek API key (required)
api_key=sk-your-deepseek-api-key

# API base URL
base_url=https://api.deepseek.com

# Stable official DeepSeek V4 model names
model=deepseek-v4-pro
model_flash=deepseek-v4-flash

# Server port
port=11435

# Upstream API timeout in minutes (default: 30)
timeout=30

# Set to false if the target model is not a DeepSeek model
is_deepseek=true

# DeepSeek official defaults: thinking enabled, regular effort high.
# Accepted thinking efforts are high/max; low+medium map to high and xhigh maps to max.
deepseek_thinking_default=enabled
deepseek_default_reasoning_effort=high

# Multimodal support: set to true if your model supports image inputs
multimodal=false

# Identity name injected into system prompt
#
# Set this to the model's official name to enable identity injection.
# Leave empty to skip injection entirely.
#
#   Official API:  identity_model=deepseek-v4-pro
#   Third-party:   identity_model=deepseek-v4-pro   (when model is a routing identifier)
identity_model=

# Optional GPT settings
#
# GPT through Codex device-code login does NOT need an OpenAI Platform API key.
# The proxy reads ~/.codex/auth.json or ~/.codex/auth.gpt.json and calls:
#   https://chatgpt.com/backend-api/codex/responses
#
# Only set openai_api_key if you want a Platform API-key fallback to /v1/responses.
openai_api_key=
# Default GPT model used only when an incoming request omits body.model
gpt_model=gpt-5.6-sol
# Concrete backend model used when requests ask for the public gpt-5.6 alias
gpt_5_6_backend_model=gpt-5.6-sol
gpt_chatgpt_backend_base_url=https://chatgpt.com/backend-api/codex
gpt_enable_app_server_fallback=false
# Models to prefer through OpenAI Platform /v1/responses when openai_api_key is set
gpt_platform_preferred_models=gpt-5.6-luna
